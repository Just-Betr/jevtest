# Copy to .env (git-ignored) and fill in. Every ${NAME} the test files use must be set here or in
# the environment; a name set in both to different values is an error.
TYPESAFE_API_KEY=apikey_...
DEMO_EMAIL=demo@jevtest.dev
DEMO_PASSWORD=hunter22
# Exact names: `adb devices` / `xcrun simctl list devices booted` / Finder or Xcode for an iPhone.
ANDROID_DEVICE=Pixel_10
IOS_DEVICE=iPhone 17 Pro
IOS_APP=../demo_app/build/ios_sim/Build/Products/Debug-iphonesimulator/Runner.app
# For a real iPhone, a device build instead:
# IOS_APP=../demo_app/build/ios_device/Build/Products/Release-iphoneos/Runner.app
